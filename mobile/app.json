{
  "expo": {
    "name": "Billora",
    "slug": "billora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "billora",
    "android": {
      "package": "com.billora.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"],
      "permissions": ["android.permission.INTERNET", "android.permission.ACCESS_NETWORK_STATE", "android.permission.USE_BIOMETRIC"]
    },
    "plugins": [
      ["expo-sqlite", {"useSQLCipher": true}],
      "expo-secure-store",
      "expo-local-authentication",
      "./plugins/withBilloraPrinter"
    ]
  }
}
