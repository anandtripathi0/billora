# Copy this file to .env for local use. Never commit .env.
# Backend
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DATABASE_URL=postgresql://billora:billora@localhost:5432/billora
DB_SSL_REQUIRE=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=false
BILLING_ENABLED=false
LOG_LEVEL=INFO

# PDFs are generated in memory. No object storage or WhatsApp API keys are required.

# SMTP: required for real password-reset email delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
# Render free blocks 25/465/587. Use a provider-supported alternative (e.g. 2525) there.
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Billora <noreply@your-domain.example>

# Frontend server ONLY. Set separately on the frontend Render service.
# For native local development, copy frontend/.env.example to frontend/.env.local.
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
